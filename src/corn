def enforce_min_block(states: np.ndarray, min_dur: int = 5) -> np.ndarray:
    states = states.copy()
    i = 0
    while i < len(states):
        j = i
        while j < len(states) and states[j] == states[i]:
            j += 1
        if (j - i) < min_dur and i > 0:
            states[i:j] = states[i - 1]
        i = j
    return states


def segment(final_test: pd.DataFrame, probas: np.ndarray,
            A: np.ndarray, enter_th=0.65, exit_th=0.50,
            proj_horizon=10, min_block=5) -> pd.DataFrame:
    """Segmentation online sans look-ahead + durée minimale."""
    n, K = probas.shape
    probas_s = pd.DataFrame(probas).ewm(span=3, adjust=False).mean().values

    states = np.zeros(n, dtype=int)
    cur = int(np.argmax(probas_s[0]))
    states[0] = cur

    for t in range(1, n):
        p = probas_s[t]
        prop = int(np.argmax(p))

        if p[cur] >= exit_th:
            states[t] = cur
            continue

        proj = p.copy()
        stay = True
        for _ in range(proj_horizon):
            proj = proj @ A
            if proj[cur] >= exit_th:
                stay = False
                break

        if stay and p[prop] >= enter_th:
            cur = prop
        states[t] = cur

    states = enforce_min_block(states, min_block)

    seg = final_test.copy()
    seg["state"]    = states
    seg["block_id"] = (seg["state"] != seg["state"].shift()).cumsum()
    seg["pmax"]     = probas_s.max(axis=1)
    return seg


def rebuild_blocks(seg: pd.DataFrame) -> pd.DataFrame:
    return (
        seg.groupby("block_id")
        .agg(
            state   =("state", "first"),
            start   =("state", lambda x: x.index[0]),
            end     =("state", lambda x: x.index[-1]),
            duration=("state", "size"),
            mean_pmax=("pmax", "mean"),
        )
        .reset_index(drop=True)
    )


