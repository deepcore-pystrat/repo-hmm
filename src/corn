def classify_red_block(row, spot, lookback=20):
    start = row["start"]
    end = row["end"]

    i0 = spot.index.get_loc(start)
    i1 = spot.index.get_loc(end)

    pre_start = max(0, i0 - lookback)

    pre_ret = np.log(spot.iloc[i0] / spot.iloc[pre_start])
    block_ret = np.log(spot.iloc[i1] / spot.iloc[i0])

    if pre_ret > 0.05 and block_ret > 0:
        return "momentum_up"

    elif pre_ret < -0.05 and block_ret < 0:
        return "crisis_down"

    elif pre_ret < -0.05 and block_ret > 0:
        return "mean_revert_up"

    elif pre_ret > 0.05 and block_ret < 0:
        return "top_reversal"

    else:
        return "transition_neutral"


