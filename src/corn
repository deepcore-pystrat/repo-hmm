def percentile_rank(x, ref):
    ref = pd.Series(ref).replace([np.inf, -np.inf], np.nan).dropna()

    if len(ref) == 0 or pd.isna(x):
        return np.nan

    return (ref <= x).mean()


def build_reference_block_metrics(futures_price, window=20):
    fut = futures_price.dropna()
    logp = np.log(fut)
    ret = logp.diff()

    rows = []

    for i in range(0, len(logp) - window):
        p = logp.iloc[i:i + window]
        r = ret.iloc[i:i + window].dropna()

        if len(r) < 5:
            continue

        total_ret = p.iloc[-1] - p.iloc[0]
        abs_ret = abs(total_ret)
        path_len = r.abs().sum()

        efficiency = abs_ret / (path_len + 1e-8)
        realized_vol = r.std()
        block_range = p.max() - p.min()

        acf1 = r.autocorr(lag=1) if len(r) > 5 else np.nan
        vr5 = variance_ratio(p, lag=5) if len(p) > 10 else np.nan

        signs = np.sign(r.values)
        signs = signs[signs != 0]

        run_ratio = np.nan
        sign_change_ratio = np.nan

        if len(signs) > 1:
            sign_change_ratio = np.mean(signs[1:] != signs[:-1])

            max_run = 1
            cur_run = 1

            for j in range(1, len(signs)):
                if signs[j] == signs[j - 1]:
                    cur_run += 1
                else:
                    max_run = max(max_run, cur_run)
                    cur_run = 1

            max_run = max(max_run, cur_run)
            run_ratio = max_run / len(signs)

        rows.append({
            "abs_ret": abs_ret,
            "efficiency": efficiency,
            "realized_vol": realized_vol,
            "block_range": block_range,
            "acf1": acf1,
            "vr5": vr5,
            "run_ratio": run_ratio,
            "sign_change_ratio": sign_change_ratio,
        })

    return pd.DataFrame(rows)
def add_contract_calendar_feature(out, df):
    month_map = {
        "F": 1, "G": 2, "H": 3, "J": 4, "K": 5, "M": 6,
        "N": 7, "Q": 8, "U": 9, "V": 10, "X": 11, "Z": 12
    }

    fut = df["FUTURES"].astype(str)

    tmp = fut.str.extract(
        r"ZC(?P<spot_month>[FGHJKMNQUVXZ])\s*(?P<future_month>[FGHJKMNQUVXZ])?(?P<yy>\d{2})"
    )

    contract_month_code = tmp["future_month"].fillna(tmp["spot_month"])
    contract_month = contract_month_code.map(month_map)
    contract_year = tmp["yy"].astype(float) + 2000

    date = pd.to_datetime(df.index)

    contract_month_start = pd.to_datetime(
        pd.DataFrame({
            "year": contract_year.astype(int),
            "month": contract_month.astype(int),
            "day": 1,
        })
    )

    out["days_to_contract_month"] = (
        contract_month_start.values.astype("datetime64[ns]")
        - date.values.astype("datetime64[ns]")
    ).astype("timedelta64[D]").astype(int)

    return out
def futures_structure_by_spot_regime(blocks, futures_price):
    fut = futures_price.dropna()
    logp = np.log(fut)
    ret = logp.diff()
    rows = []

    for _, row in blocks.iterrows():
        s = int(row["state"])
        start, end = row["start"], row["end"]

        if start not in fut.index or end not in fut.index:
            continue

        p = logp.loc[start:end]
        r = ret.loc[start:end]

        if len(p) < 5:
            continue

        total_ret = p.iloc[-1] - p.iloc[0]
        path_len = r.abs().sum()
        efficiency = abs(total_ret) / (path_len + 1e-8)
        realized_vol = r.std()
        direction = np.sign(total_ret)

        if efficiency > 0.55 and direction > 0:
            regime_type = "TREND_UP"
        elif efficiency > 0.55 and direction < 0:
            regime_type = "TREND_DOWN"
        elif realized_vol > ret.rolling(60).std().median():
            regime_type = "CHOPPY_HIGH_VOL"
        else:
            regime_type = "SIDEWAYS"

        rows.append({
            "spot_state": s,
            "start": start,
            "end": end,
            "duration": len(p),
            "fut_ret": total_ret,
            "fut_efficiency": efficiency,
            "fut_realized_vol": realized_vol,
            "fut_type": regime_type,
        })

    res = pd.DataFrame(rows)

    print("\n=== Structure FUTURES à l'intérieur des régimes SPOT ===")
    print(res.groupby(["spot_state", "fut_type"]).size())

    print("\n=== Moyennes par régime spot ===")
    print(res.groupby("spot_state")[[
        "fut_ret", "fut_efficiency", "fut_realized_vol", "duration"
    ]].mean())

