def build_dataset(shift_spot: bool = True) -> pd.DataFrame:
    spot = load_spot()
    fut  = load_futures()
    data = pd.merge(spot, fut, on="Date", how="inner")
    data = data.sort_values("Date")

    if shift_spot:
        for c in ["BID","OFFER","MID","BA_SPREAD"]:
            data[c] = data[c].shift(1)
        data = data.dropna(subset=["MID","FUTURES_CLOSE"])

    data = data[
        (data["MID"] > 0) & (data["FUTURES_CLOSE"] > 0) & (data["BA_SPREAD"] >= 0)
    ].set_index("Date")
    return data


