        i = fut.index.get_loc(start)

        for h in horizons:
            if i + h >= len(fut):
                continue

            r_fwd = logp.iloc[i + h] - logp.iloc[i]
            abs_r_fwd = abs(r_fwd)

            path_len = ret.abs().iloc[i + 1:i + h + 1].sum()
            eff_fwd = abs_r_fwd / (path_len + eps)

            rows.append({
