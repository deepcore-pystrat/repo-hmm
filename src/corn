import numpy as np
import pandas as pd


def variance_ratio(x, lag=5):
    x = pd.Series(x).dropna()
    if len(x) < lag + 2:
        return np.nan

    r1 = x.diff().dropna()
    rq = x.diff(lag).dropna()

    v1 = r1.var()
    vq = rq.var()

    if v1 == 0:
        return np.nan

    return vq / (lag * v1)


def hurst_exponent(ts):
    ts = np.asarray(ts)

    if len(ts) < 50:
        return np.nan

    lags = range(2, 20)

    tau = [
        np.sqrt(np.std(np.subtract(ts[lag:], ts[:-lag])))
        for lag in lags
    ]

    poly = np.polyfit(np.log(lags), np.log(tau), 1)

    return poly[0] * 2.0


def ou_half_life(series):
    s = pd.Series(series).dropna()

    if len(s) < 20:
        return np.nan

    lagged = s.shift(1).dropna()
    delta = s.diff().dropna()

    lagged = lagged.loc[delta.index]

    beta = np.polyfit(lagged, delta, 1)[0]

    if beta >= 0:
        return np.nan

    return -np.log(2) / beta

def add_contract_features(out, df):
    month_map = {
        "F": 1, "G": 2, "H": 3, "J": 4, "K": 5, "M": 6,
        "N": 7, "Q": 8, "U": 9, "V": 10, "X": 11, "Z": 12
    }

    fut = df["FUTURES"].astype(str)

    tmp = fut.str.extract(
        r"ZC(?P<spot_month>[FGHJKMNQUVXZ])\s*(?P<future_month>[FGHJKMNQUVXZ])?(?P<yy>\d{2})"
    )

    contract_month_code = tmp["future_month"].fillna(tmp["spot_month"])
    contract_month = contract_month_code.map(month_map)
    contract_year = tmp["yy"].astype(float) + 2000

    date = pd.to_datetime(df.index)

    months_to_delivery = (
        (contract_year.values - date.year) * 12
        + (contract_month.values - date.month)
    )

    out["contract_season_sin"] = np.sin(2 * np.pi * contract_month / 12)
    out["contract_season_cos"] = np.cos(2 * np.pi * contract_month / 12)
    out["months_to_delivery"] = months_to_delivery

    return out
def build_features(
    df: pd.DataFrame,
    price_col: str = "MID",
    spread_col: str = "BA_SPREAD",
    eps: float = 1e-8,
) -> pd.DataFrame:

    out = pd.DataFrame(index=df.index)

    price = pd.to_numeric(df[price_col], errors="coerce")
    logp = np.log(price)
    ret = logp.diff()

    spread = pd.to_numeric(df[spread_col], errors="coerce")

    # =========================
    # 1) Momentum / direction
    # =========================

    out["ret_1"] = ret.shift(1)

    out["ret_5"] = logp.shift(1) - logp.shift(6)
    out["ret_20"] = logp.shift(1) - logp.shift(21)
    out["ret_60"] = logp.shift(1) - logp.shift(61)

    out["mom_20_vol_adj"] = (
        out["ret_20"] / (ret.shift(1).rolling(60).std() + eps)
    )

    out["mom_60_vol_adj"] = (
        out["ret_60"] / (ret.shift(1).rolling(120).std() + eps)
    )

    # =========================
    # 2) Volatility regime
    # =========================

    vol_20 = ret.shift(1).rolling(20).std()
    vol_60 = ret.shift(1).rolling(60).std()
    vol_120 = ret.shift(1).rolling(120).std()
    out["vol_20"] = vol_20
    out["vol_60"] = vol_60

    out["vol_ratio_20_120"] = vol_20 / (vol_120 + eps)

    out["vol_z_20"] = (
        (vol_20 - vol_20.rolling(120).mean())
        / (vol_20.rolling(120).std() + eps)
    )

    out["abs_ret_z_20"] = (
        (ret.shift(1).abs().rolling(20).mean()
         - ret.shift(1).abs().rolling(120).mean())
        / (ret.shift(1).abs().rolling(120).std() + eps)
    )

    # =========================
    # 3) Market stress / liquidity
    # =========================

    spread_lag = spread.shift(1)

    out["spread_z_60"] = (
        (spread_lag - spread_lag.rolling(120).mean())
        / (spread_lag.rolling(120).std() + eps)
    )

    out["spread_ratio_20_120"] = (
        spread_lag.rolling(20).mean()
        / (spread_lag.rolling(120).mean() + eps)
    )

    out["spread_vol_20"] = spread_lag.rolling(20).std()

    out["stress_proxy"] = (
        out["vol_ratio_20_120"] * out["spread_ratio_20_120"]
    )

    # =========================
    # 4) Trend vs mean-reversion
    # =========================

    out["efficiency_20"] = (
        abs(logp.shift(1) - logp.shift(21))
        / (ret.shift(1).abs().rolling(20).sum() + eps)
    )

    out["efficiency_60"] = (
        abs(logp.shift(1) - logp.shift(61))
        / (ret.shift(1).abs().rolling(60).sum() + eps)
    )

    out["acf1_20"] = ret.shift(1).rolling(20).apply(
        lambda x: pd.Series(x).autocorr(lag=1),
        raw=False
    )

    out["acf5_60"] = ret.shift(1).rolling(60).apply(
        lambda x: pd.Series(x).autocorr(lag=5),
        raw=False
    )

    out["vr_5"] = ret.shift(1).rolling(60).apply(
        lambda x: variance_ratio(x, lag=5),
        raw=False
    )

    out["vr_20"] = ret.shift(1).rolling(120).apply(
        lambda x: variance_ratio(x, lag=20),
        raw=False
    )

    out["d_vr_5"] = out["vr_5"].diff()

    # =========================
    # 5) Position in local range
    # =========================

    roll_min = logp.shift(1).rolling(60).min()
    roll_max = logp.shift(1).rolling(60).max()

    out["range_pos_60"] = (
        (logp.shift(1) - roll_min)
        / (roll_max - roll_min + eps)
    )

    out["drawdown_60"] = (
        logp.shift(1) - logp.shift(1).rolling(60).max()
    )

    # =========================
    # 6) Optional latent structure
    # =========================

    out["hurst_100"] = logp.shift(1).rolling(100).apply(
        hurst_exponent,
        raw=False
    )

    out["half_life_60"] = logp.shift(1).rolling(60).apply(
        ou_half_life,
        raw=False
    )
    out["spread_vol_z_60"] = (
    (out["spread_vol_20"] - out["spread_vol_20"].rolling(60).mean())
    / (out["spread_vol_20"].rolling(60).std() + eps)
)
    out["vol_of_vol_20"] = vol_20.rolling(20).std()

    out["vol_of_vol_z_60"] = (
    (out["vol_of_vol_20"] - out["vol_of_vol_20"].rolling(60).mean())
    / (out["vol_of_vol_20"].rolling(60).std() + eps)
)
    out["entropy_20"] = ret.shift(1).rolling(20).apply(
    sign_entropy,
    raw=False
)
    if "FUTURES" in df.columns:
        out = add_contract_calendar_feature(out, df)

    
    
    # =========================
    # Clean
    # =========================

    out = out.replace([np.inf, -np.inf], np.nan)
    out = out.dropna()

    return out
def sign_entropy(x):
    x = pd.Series(x).dropna()

    if len(x) < 5:
        return np.nan

    signs = np.sign(x)

    p_pos = (signs > 0).mean()
    p_neg = (signs < 0).mean()
    p_zero = (signs == 0).mean()

    probs = np.array([p_pos, p_neg, p_zero])
    probs = probs[probs > 0]

    return -np.sum(probs * np.log(probs))
