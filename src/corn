    horizons=(5, 10, 20, 30),
    eff_window=20,
):
    """
    Teste ce que deviennent les futures après le début de chaque bloc HMM spot.
    Mesure:
      - futures return forward
      - futures absolute return forward
      - futures efficiency forward
    """

    fut = futures_price.dropna().copy()
    logp = np.log(fut)
    ret = logp.diff()
    eps = 1e-8

    rows = []

