def validate_regimes(
    final_test: pd.DataFrame,      # colonnes: state, pmax, p0..pK-1
    feat_test:  pd.DataFrame,
    price_test: pd.Series,
    selected_cols: list,
    min_state_pct: float = 0.05,
) -> dict:
    """
    5 tests. Retourne warnings (int) + conclusion (str).
    Règle : ≥ 3 warnings → régimes non fiables.
    """
    df    = final_test.copy()
    state = "state"
    df[state] = df[state].astype(int)

    print("\n" + "=" * 70)
    print("PHASE 1 — VALIDATION DES RÉGIMES (TEST OOS)")
    print("=" * 70)

    warnings = 0

    # ── Test 1 : occupation ──────────────────────────────────────────────
    counts = df[state].value_counts().sort_index()
    pct    = counts / len(df)
    print(f"\n[1] Occupation des états")
    print(pd.DataFrame({"n": counts, "pct": pct}).round(3).to_string())
    rare = pct[pct < min_state_pct].index.tolist()
    if rare:
        print(f"  ⚠ États trop rares : {rare}")
        warnings += 1
    else:
        print("  ✓ Tous les états ≥ 5 %")

    # ── Test 2 : durée des blocs ─────────────────────────────────────────
    tmp = df[[state]].copy()
    tmp["block_id"] = (tmp[state] != tmp[state].shift()).cumsum()
    blocks = tmp.groupby("block_id").agg(
        state=(state, "first"), duration=(state, "size")
    )
    dur_med = blocks["duration"].median()
    print(f"\n[2] Durée des blocs (médiane = {dur_med:.1f} j)")
    print(blocks.groupby("state")["duration"].agg(["count","mean","median","min","max"]).round(1).to_string())
    if dur_med <= 2:
        print("  ⚠ Médiane ≤ 2 j — HMM trop bruité")
        warnings += 1
    else:
        print("  ✓ Durées raisonnables")

    # ── Test 3 : confiance pmax ──────────────────────────────────────────
    if "pmax" in df.columns:
        low = (df["pmax"] < 0.60).mean()
        print(f"\n[3] Confiance pmax — pct < 0.60 : {low:.1%}")
        print(df["pmax"].describe().round(3).to_string())
        if low > 0.40:
            print("  ⚠ Trop de points peu confiants")
            warnings += 1
        else:
            print("  ✓ Probabilités confiantes")

    # ── Test 4 : séparabilité des features (Kruskal-Wallis) ─────────────
    aligned = feat_test.loc[df.index.intersection(feat_test.index)].copy()
    aligned[state] = df.loc[aligned.index, state].values
    rows = []
    for col in selected_cols:
        if col not in aligned.columns:
            continue
        groups = [
            aligned.loc[aligned[state] == s, col].dropna().values
            for s in sorted(aligned[state].unique())
        ]
        groups = [g for g in groups if len(g) > 2]
        if len(groups) < 2:
            continue
        h, p = stats.kruskal(*groups)
        rows.append({"feature": col, "H": h, "p": p, "sig": p < 0.05})
    feat_df = pd.DataFrame(rows)
    print(f"\n[4] Séparabilité des features (Kruskal-Wallis)")
    print(feat_df.sort_values("p").round(4).to_string(index=False))
    n_sig = feat_df["sig"].sum() if not feat_df.empty else 0
    if n_sig <= max(1, len(feat_df) // 4):
        print("  ⚠ Peu de features séparent réellement les régimes")
        warnings += 1
    else:
        print(f"  ✓ {n_sig}/{len(feat_df)} features significatives")

    # ── Test 5 : volatilité réalisée par état ───────────────────────────
    ret    = np.log(price_test / price_test.shift(1))
    vol5   = ret.rolling(5).std()
    vol20  = ret.rolling(20).std()
    check  = df.copy()
    check["vol5"]  = vol5
    check["vol20"] = vol20
    vol_rows = []
    for vc in ["vol5", "vol20"]:
        x = check[[state, vc]].dropna()
        groups = [x.loc[x[state] == s, vc].values for s in sorted(x[state].unique())]
        groups = [g for g in groups if len(g) > 2]
        if len(groups) < 2:
            continue
        h, p = stats.kruskal(*groups)
        means = x.groupby(state)[vc].mean()
        vol_rows.append({
            "vol": vc, "H": h, "p": p,
            "ratio max/min": means.max() / (means.min() + 1e-12),
            "sig": p < 0.05,
        })
    vol_df = pd.DataFrame(vol_rows)
    print(f"\n[5] Séparation volatilité réalisée")
    print(vol_df.round(4).to_string(index=False))
    if not vol_df.empty and not vol_df["sig"].any():
        print("  ⚠ Aucune différence de vol significative entre états")
        warnings += 1
    else:
        print("  ✓ Vol réalisée différente entre états")

    # ── Synthèse ─────────────────────────────────────────────────────────
    print("\n" + "-" * 70)
    if warnings >= 3:
        conclusion = f"❌ {warnings}/5 warnings — régimes non fiables (revoir K ou features)"
    elif warnings == 2:
        conclusion = f"⚠  {warnings}/5 warnings — régimes partiellement crédibles"
    else:
        conclusion = f"✓  {warnings}/5 warnings — régimes statistiquement défendables"
    print("SYNTHÈSE :", conclusion)
    print("-" * 70)

    return {"warnings": warnings, "conclusion": conclusion, "blocks": blocks, "feat_sep": feat_df}


