def select_k(X: np.ndarray, k_range=(2, 3, 4)) -> pd.DataFrame:
    """Choisir K par BIC sur les données d'entraînement."""
    n, d = X.shape
    rows = []
    for k in k_range:
        try:
            m, r = fit_hmm(X, k)
            ll = r.ll_hist[-1]
            n_params = k * d + k * d + k * (k - 1) + (k - 1)
            bic = -2 * ll + n_params * np.log(n)
            aic = -2 * ll + 2 * n_params
            rows.append({"K": k, "LL": ll, "BIC": bic, "AIC": aic})
        except Exception as e:
            print(f"  K={k} échec : {e}")
    df = pd.DataFrame(rows)
    print("\n=== Sélection K ===")
    print(df.round(1).to_string(index=False))
    if not df.empty:
        print(f"  → K optimal (BIC) : {df.loc[df['BIC'].idxmin(),'K']}")
    return df




