def map_states_by_behavior(states_raw, alpha_raw, feat, selected_cols):
    tmp = feat[selected_cols].copy()
    tmp["state_raw"] = states_raw

    means = tmp.groupby("state_raw")[selected_cols].mean()

    means["stress_score"] = (
        means.get("vol_z_20", 0)
        + means.get("vol_ratio_20_120", 0)
        + means.get("abs_ret_z_20", 0)
        + means.get("spread_z_60", 0)
        + means.get("spread_ratio_20_120", 0)
        + means.get("spread_vol_z_60", 0)
        + means.get("stress_proxy", 0)
        + means.get("vol_of_vol_z_60", 0)
    )

    means["sideways_score"] = (
        means.get("entropy_20", 0)
        - means.get("efficiency_20", 0)
        - means.get("vr_5", 0)
        - means.get("vol_z_20", 0)
        - means.get("abs_ret_z_20", 0)
    )

    means["organized_score"] = (
        means.get("efficiency_20", 0)
        + means.get("vr_5", 0)
        - means.get("entropy_20", 0)
        - means.get("vol_of_vol_z_60", 0)
    )

    raw_states = list(means.index)

    stress_raw = means["stress_score"].idxmax()

    candidates = [s for s in raw_states if s != stress_raw]

    if len(candidates) == 0:
        raise ValueError("Impossible de mapper les états : un seul état brut détecté.")

    sideways_raw = means.loc[candidates, "sideways_score"].idxmax()

    candidates2 = [s for s in raw_states if s not in [stress_raw, sideways_raw]]

    if len(candidates2) > 0:
        organized_raw = means.loc[candidates2, "organized_score"].idxmax()
    else:
        # fallback : si K=2 ou collision inattendue
        organized_raw = means["organized_score"].idxmax()
        if organized_raw in [stress_raw, sideways_raw]:
            organized_raw = candidates[0]

    mapping = {
        sideways_raw: 0,      # sideways / compression
        stress_raw: 1,        # stress / dislocation
        organized_raw: 2,     # organized / persistent
    }

    # Si collision dans le mapping, assigner les états restants proprement
    used_old = set(mapping.keys())
    unused_old = [s for s in raw_states if s not in used_old]
    used_new = set(mapping.values())
    unused_new = [s for s in range(len(raw_states)) if s not in used_new]

    for old, new in zip(unused_old, unused_new):
        mapping[old] = new

    states_new = np.array([mapping[s] for s in states_raw], dtype=int)

    alpha_new = np.zeros_like(alpha_raw)
    for old, new in mapping.items():
        if old < alpha_raw.shape[1] and new < alpha_raw.shape[1]:
            alpha_new[:, new] = alpha_raw[:, old]

    print("\n=== Mapping latent MARKET regimes ===")
    print(means.round(4))
    print("mapping old -> new:", mapping)
    print("0 = sideways / compression")
    print("1 = stress / dislocation")
    print("2 = organized / persistent")

    return states_new, alpha_new, mapping
def apply_mapping(states_raw, alpha_raw, mapping):
    K_raw = alpha_raw.shape[1]

    # garder seulement les mappings valides
    valid_mapping = {
        old: new
        for old, new in mapping.items()
        if old < K_raw and new < K_raw
    }

    # si un état raw manque, on le mappe vers lui-même si possible
    for old in range(K_raw):
        if old not in valid_mapping:
            valid_mapping[old] = old

    states_new = np.array(
        [valid_mapping.get(int(s), int(s)) for s in states_raw],
        dtype=int
    )

    alpha_new = np.zeros_like(alpha_raw)

    for old, new in valid_mapping.items():
        alpha_new[:, new] = alpha_raw[:, old]

    return states_new, alpha_new
