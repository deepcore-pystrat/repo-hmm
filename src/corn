def event_study_red_block_ends(
    blocks,
    data,
    state_transition=1,
    futures_col="FUTURES_CLOSE",
    horizons=(5, 10, 20, 30),
    n_perm=5000,
    seed=42,
):
    rng = np.random.default_rng(seed)

    fut = pd.to_numeric(data[futures_col], errors="coerce").dropna()

    red_blocks = blocks[blocks["state"] == state_transition].copy()
    event_dates = red_blocks["end"].tolist()

    rows = []

    for h in horizons:
        event_rets = []

        for d in event_dates:
            if d not in fut.index:
                continue

            idx = fut.index.get_loc(d)

            if idx + h >= len(fut):
                continue

            r = np.log(fut.iloc[idx + h] / fut.iloc[idx])
            event_rets.append(r)

        event_rets = np.array(event_rets)

        valid_start = 0
        valid_end = len(fut) - h - 1
        all_idx = np.arange(valid_start, valid_end)

        if len(event_rets) == 0:
            continue

        perm_means = []

        for _ in range(n_perm):
            sample_idx = rng.choice(all_idx, size=len(event_rets), replace=False)
            sample_rets = np.log(
                fut.iloc[sample_idx + h].values / fut.iloc[sample_idx].values
            )
            perm_means.append(sample_rets.mean())

        perm_means = np.array(perm_means)

        event_mean = event_rets.mean()
        event_hit = (event_rets > 0).mean()

        p_right = (perm_means >= event_mean).mean()
        p_left = (perm_means <= event_mean).mean()
        p_two_sided = 2 * min(p_right, p_left)

        rows.append({
            "horizon": h,
            "n_events": len(event_rets),
            "mean_event_ret_pct": 100 * event_mean,
            "median_event_ret_pct": 100 * np.median(event_rets),
            "hit_ratio_up": event_hit,
            "random_mean_pct": 100 * perm_means.mean(),
            "p_value_perm": p_two_sided,
        })

    res = pd.DataFrame(rows)

    print("\n=== EVENT STUDY — FIN DES BLOCS ROUGES → FUTURES ===")
    print(res.round(4).to_string(index=False))

    return res

