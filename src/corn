def forward_momentum_metrics(futures_price, start_date, horizon=5):
    fut = futures_price.dropna()
    logp = np.log(fut)
    ret = logp.diff()

    if start_date not in fut.index:
        return None

    i = fut.index.get_loc(start_date)

    if i + horizon >= len(fut):
        return None

    start_price = logp.iloc[i]
    end_price = logp.iloc[i + horizon]

    fwd_ret = end_price - start_price

    path_len = ret.iloc[i + 1:i + horizon + 1].abs().sum()

    eff = abs(fwd_ret) / (path_len + 1e-8)

    direction = np.sign(fwd_ret)

    return {
        "date": fut.index[i],
        "fwd_ret": fwd_ret,
        "abs_ret": abs(fwd_ret),
        "efficiency": eff,
        "direction": direction,
    }

def detect_first_futures_momentum_after_spot_block(
    futures_price,
    spot_block_start,
    horizon=5,
    max_lag=15,
    eff_threshold=0.55,
    min_abs_ret=0.01,
):
    results = []

    fut = futures_price.dropna()

    if spot_block_start not in fut.index:
        return None, pd.DataFrame()

    start_i = fut.index.get_loc(spot_block_start)

    for lag in range(max_lag + 1):

        if start_i + lag >= len(fut):
            break

        test_date = fut.index[start_i + lag]

        m = forward_momentum_metrics(
            futures_price=fut,
            start_date=test_date,
            horizon=horizon,
        )

        if m is None:
            continue

        m["lag"] = lag
        results.append(m)

        if (m["efficiency"] >= eff_threshold) and (m["abs_ret"] >= min_abs_ret):
            return m, pd.DataFrame(results)

    return None, pd.DataFrame(results)

def extend_futures_momentum_segment(
    futures_price,
    momentum_start,
    direction,
    horizon=5,
    exit_eff_threshold=0.35,
    max_duration=40,
):
    fut = futures_price.dropna()
    logp = np.log(fut)
    ret = logp.diff()

    if momentum_start not in fut.index:
        return None

    i0 = fut.index.get_loc(momentum_start)

    last_good_i = i0

    for i in range(i0 + horizon, min(i0 + max_duration, len(fut) - 1)):

        r = logp.iloc[i] - logp.iloc[i - horizon]
        path = ret.iloc[i - horizon + 1:i + 1].abs().sum()
        eff = abs(r) / (path + 1e-8)

        same_direction = np.sign(r) == direction

        if eff >= exit_eff_threshold and same_direction:
            last_good_i = i
        else:
            break

    return {
        "momentum_start": fut.index[i0],
        "momentum_end": fut.index[last_good_i],
        "duration": last_good_i - i0 + 1,
    }

