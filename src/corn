def classify_projected_futures_blocks(
    blocks,
    futures_price,
    min_duration=5,
):
    fut = futures_price.dropna().copy()
    logp = np.log(fut)
    ret = logp.diff()

    ref = build_reference_block_metrics(futures_price, window=20)

    rows = []

    for block_id, row in blocks.iterrows():

        spot_state = int(row["state"])
        start = row["start"]
        end = row["end"]

        sub = fut.loc[start:end].dropna()

        if len(sub) < min_duration:
            continue

        p = np.log(sub)
        r = p.diff().dropna()

        if len(r) < 5:
            continue

        total_ret = p.iloc[-1] - p.iloc[0]
        abs_ret = abs(total_ret)
        direction = np.sign(total_ret)

        path_len = r.abs().sum()
        efficiency = abs_ret / (path_len + 1e-8)

        realized_vol = r.std()
        block_range = p.max() - p.min()

        acf1 = r.autocorr(lag=1) if len(r) > 5 else np.nan
        vr5 = variance_ratio(p, lag=5) if len(p) > 10 else np.nan

        signs = np.sign(r.values)
        signs = signs[signs != 0]

        run_ratio = np.nan
        sign_change_ratio = np.nan

        if len(signs) > 1:
            sign_change_ratio = np.mean(signs[1:] != signs[:-1])

            max_run = 1
            cur_run = 1

            for j in range(1, len(signs)):
                if signs[j] == signs[j - 1]:
                    cur_run += 1
                else:
                    max_run = max(max_run, cur_run)
                    cur_run = 1

            max_run = max(max_run, cur_run)
            run_ratio = max_run / len(signs)

        # =========================
        # Percentile ranks
        # =========================

        vol_rank = percentile_rank(realized_vol, ref["realized_vol"])
        range_rank = percentile_rank(block_range, ref["block_range"])
        absret_rank = percentile_rank(abs_ret, ref["abs_ret"])
        eff_rank = percentile_rank(efficiency, ref["efficiency"])
        run_rank = percentile_rank(run_ratio, ref["run_ratio"])
        vr_rank = percentile_rank(vr5, ref["vr5"])
        acf_rank = percentile_rank(acf1, ref["acf1"])
        signchg_rank = percentile_rank(sign_change_ratio, ref["sign_change_ratio"])

        # =========================
        # Scores de régime
        # =========================

        stress_score = np.nanmean([
            vol_rank,
            range_rank,
            absret_rank,
            1 - eff_rank,
        ])

        trend_score = np.nanmean([
            eff_rank,
            range_rank,
            absret_rank,
            run_rank,
        ])

        momentum_score = np.nanmean([
            eff_rank,
            run_rank,
            vr_rank,
            acf_rank,
        ])

        mean_reversion_score = np.nanmean([
            1 - eff_rank,
            1 - vr_rank,
            1 - acf_rank,
            signchg_rank,
        ])

        calm_score = np.nanmean([
            1 - vol_rank,
            1 - range_rank,
            1 - absret_rank,
        ])

        scores = {
            "STRESS": stress_score,
            "TREND": trend_score,
            "MOMENTUM": momentum_score,
            "MEAN_REVERSION": mean_reversion_score,
            "CALM": calm_score,
        }

        fut_label = max(scores, key=scores.get)

        sorted_scores = sorted(scores.values(), reverse=True)
        label_confidence = sorted_scores[0] - sorted_scores[1]

        rows.append({
            "block_id": block_id,
            "spot_state": spot_state,
            "start": start,
            "end": end,
            "duration": len(sub),

            "fut_label": fut_label,
            "label_confidence": label_confidence,

            "fut_ret": total_ret,
            "fut_abs_ret": abs_ret,
            "fut_direction": direction,
            "fut_efficiency": efficiency,
            "fut_realized_vol": realized_vol,
            "fut_range": block_range,
            "fut_acf1": acf1,
            "fut_vr5": vr5,
            "fut_run_ratio": run_ratio,
            "fut_sign_change_ratio": sign_change_ratio,

            "stress_score": stress_score,
            "trend_score": trend_score,
            "momentum_score": momentum_score,
            "mean_reversion_score": mean_reversion_score,
            "calm_score": calm_score,
        })

    res = pd.DataFrame(rows)

    print("\n" + "=" * 80)
    print("BLOCK-LEVEL FUTURES VALIDATION — ROBUST REGIME SCORES")
    print("=" * 80)

    if res.empty:
        print("Aucun bloc futures valide.")
        return res, pd.DataFrame()

    cols = [
        "spot_state",
        "start",
        "end",
        "duration",
        "fut_label",
        "label_confidence",
        "fut_ret",
        "fut_efficiency",
        "fut_realized_vol",
        "fut_range",
        "fut_acf1",
        "fut_vr5",
        "fut_run_ratio",
        "fut_sign_change_ratio",
        "stress_score",
        "trend_score",
        "momentum_score",
        "mean_reversion_score",
        "calm_score",
    ]

    print("\n=== Projected futures blocks ===")
    print(res[cols].round(4).to_string(index=False))

    counts = pd.crosstab(res["spot_state"], res["fut_label"])
    freq = pd.crosstab(res["spot_state"], res["fut_label"], normalize="index")

    print("\n=== Count futures labels by spot state ===")
    print(counts)

    print("\n=== Frequency futures labels by spot state ===")
    print(freq.round(3))

    print("\n=== Mean scores by spot state ===")
    print(
        res.groupby("spot_state")[
            [
                "stress_score",
                "trend_score",
                "momentum_score",
                "mean_reversion_score",
                "calm_score",
                "label_confidence",
            ]
        ].mean().round(3)
    )

    return res, freq
