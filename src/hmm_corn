def variance_ratio(x, lag=5):
    x = pd.Series(x).dropna()

    if len(x) < lag + 2:
        return np.nan

    r1 = x.diff().dropna()
    rq = x.diff(lag).dropna()

    v1 = r1.var()
    vq = rq.var()

    if v1 == 0:
        return np.nan

    return vq / (lag * v1)


def sign_entropy(x):
    x = pd.Series(x).dropna()

    if len(x) < 5:
        return np.nan

    signs = np.sign(x)

    probs = np.array([
        (signs > 0).mean(),
        (signs < 0).mean(),
        (signs == 0).mean(),
    ])

    probs = probs[probs > 0]
    return -np.sum(probs * np.log(probs))


def add_contract_calendar_feature(out, df):
    month_map = {
        "F": 1, "G": 2, "H": 3, "J": 4, "K": 5, "M": 6,
        "N": 7, "Q": 8, "U": 9, "V": 10, "X": 11, "Z": 12,
    }

    fut = df["FUTURES"].astype(str)

    tmp = fut.str.extract(
        r"ZC(?P<spot_month>[FGHJKMNQUVXZ])\s*(?P<future_month>[FGHJKMNQUVXZ])?(?P<yy>\d{2})"
    )

    contract_month_code = tmp["future_month"].fillna(tmp["spot_month"])
    contract_month = contract_month_code.map(month_map)
    contract_year = tmp["yy"].astype(float) + 2000

    date = pd.to_datetime(df.index)

    contract_month_start = pd.to_datetime(
        pd.DataFrame({
            "year": contract_year.astype(int),
            "month": contract_month.astype(int),
            "day": 1,
        })
    )

    out["days_to_contract_month"] = (
        contract_month_start.values.astype("datetime64[ns]")
        - date.values.astype("datetime64[ns]")
    ).astype("timedelta64[D]").astype(int)

    return out

def _ar1_beta(x, eps=1e-8):
    s = pd.Series(x).dropna()

    if len(s) < 5:
        return np.nan

    y = s.diff().dropna()
    x_lag = s.shift(1).dropna().reindex(y.index)

    if x_lag.std() < eps:
        return np.nan

    return np.cov(y.values, x_lag.values)[0, 1] / (x_lag.var() + eps)
def build_features(df, eps=1e-8):
    out = pd.DataFrame(index=df.index)

    spot   = pd.to_numeric(df["MID"],       errors="coerce")
    bid    = pd.to_numeric(df["BID"],       errors="coerce")
    ask    = pd.to_numeric(df["OFFER"],     errors="coerce")
    spread = pd.to_numeric(df["BA_SPREAD"], errors="coerce")

    log_spot = np.log(spot.clip(lower=eps))
    r_spot   = log_spot.diff()
    r_lag    = r_spot.shift(1)

    # ── vol_20 ───────────────────────────────────────────────
    out["vol_20"] = r_lag.rolling(20).std()

    # ── ret_20 / ret_60 ──────────────────────────────────────
    out["ret_20"] = log_spot.shift(1) - log_spot.shift(21)
    out["ret_60"] = log_spot.shift(1) - log_spot.shift(61)

    # ── vol_skew_diff_20 ─────────────────────────────────────
    r_down = r_lag.where(r_lag < 0, 0.0)
    r_up   = r_lag.where(r_lag > 0, 0.0)
    out["downside_vol_20"] = r_down.rolling(20).std()
    out["vol_skew_diff_20"] = (
        out["downside_vol_20"] - r_up.rolling(20).std()
    )

    # ── roll_20 (Roll estimator) ─────────────────────────────
    log_bid = np.log(bid.clip(lower=eps))
    log_ask = np.log(ask.clip(lower=eps))
    r_bid   = log_bid.diff().shift(1)

    cov_20 = r_bid.rolling(20).apply(
        lambda x: np.cov(
            pd.Series(x).dropna().values[1:],
            pd.Series(x).dropna().values[:-1]
        )[0, 1] if len(pd.Series(x).dropna()) > 5 else np.nan,
        raw=False,
    )
    out["roll_20"] = 2.0 * np.sqrt(np.maximum(-cov_20, 0.0))

    # ── illiq_proxy_20 (Amihud) ──────────────────────────────
    rel_spread  = spread.shift(1) / (spot.shift(1) + eps)
    illiq_daily = r_lag.abs() / (rel_spread.clip(lower=1e-5) + eps)
    out["illiq_proxy_20"] = illiq_daily.rolling(20).mean().clip(upper=100)

    # ── range_20 ─────────────────────────────────────────────
    price_lag = spot.shift(1)
    out["range_20"] = (
        np.log(price_lag.rolling(20).max() + eps)
        - np.log(price_lag.rolling(20).min() + eps)
    )

    # ── ret_kurt_20 ──────────────────────────────────────────
    out["ret_kurt_20"] = r_lag.rolling(20).kurt()

    # ── Nettoyage ────────────────────────────────────────────
    out = out.replace([np.inf, -np.inf], np.nan)
    out = out.dropna()

    return out#==========================================================
