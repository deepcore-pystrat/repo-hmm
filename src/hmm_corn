def fit_hmm(X, K):
    if HMM_TYPE == "student":
        cfg = StudentTHMMConfig(
            K=K,
            n_iter=150,
            seed=SEED,
            cov_type="full",
            min_var=1e-3,
            sticky=0.5,
            estimate_nu=False,
            fixed_nu=6.0,
        )
    else:
        cfg = GaussianHMMConfig(
            K=K,
            n_iter=150,
            seed=SEED,
            cov_type="diag",
        )

    model = create_hmm(cfg)
    result = model.fit(X)

    return model, result


def select_k(X, k_range=(2, 3, 4)):
    n, d = X.shape
    rows = []

    for k in k_range:
        try:
            model, result = fit_hmm(X, k)
            ll = result.ll_hist[-1]

            n_params = k * d + k * d + k * (k - 1) + (k - 1)

            rows.append({
                "K": k,
                "LL": ll,
                "BIC": -2 * ll + n_params * np.log(n),
                "AIC": -2 * ll + 2 * n_params,
            })

        except Exception as e:
            print(f"K={k} failed: {e}")

    res = pd.DataFrame(rows)

    print("\n=== HMM K SELECTION ===")
    print(res.round(2).to_string(index=False))

    return res


