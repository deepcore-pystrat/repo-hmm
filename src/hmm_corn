def extract_blocks_from_feed(state_feed, min_len=5):
    df = state_feed.copy()
    df["block_id"] = (df["spot_state"] != df["spot_state"].shift()).cumsum()

    rows = []

    for block_id, g in df.groupby("block_id"):
        if len(g) < min_len:
            continue

        rows.append({
            "block_id": int(block_id),
            "state": int(g["spot_state"].iloc[0]),
            "start": g.index[0],
            "end": g.index[-1],
            "length": len(g),
            "confidence_mean": g["spot_state_confidence"].mean(),
        })

    return pd.DataFrame(rows)

def compute_future_block_metrics(blocks, data, eps=1e-8):
    rows = []

    log_fut = np.log(data["FUTURES_CLOSE"].astype(float))

    for _, b in blocks.iterrows():
        start = b["start"]
        end = b["end"]

        p = log_fut.loc[start:end].dropna()

        if len(p) < 5:
            continue

        r = p.diff().dropna()

        if len(r) < 3:
            continue

        total_ret = p.iloc[-1] - p.iloc[0]
        path_len = r.abs().sum()

        signs = np.sign(r.values)
        signs = signs[signs != 0]

        signchg = (
            np.mean(signs[1:] != signs[:-1])
            if len(signs) > 1
            else np.nan
        )

        rows.append({
            "block_id": b["block_id"],
            "state": b["state"],
            "start": b["start"],
            "end": b["end"],
            "length": b["length"],
            "confidence_mean": b["confidence_mean"],

            "fut_return": total_ret,
            "fut_abs_return": abs(total_ret),
            "fut_path": path_len,
            "fut_efficiency": abs(total_ret) / (path_len + eps),
            "fut_rv": np.sum(r ** 2),
            "fut_vol": r.std(),
            "fut_signchg": signchg,
        })

    return pd.DataFrame(rows)


def score_and_label_blocks(block_metrics, feat, eps=1e-8, min_margin=0.20):
    df = block_metrics.copy()

    rel_spreads = []

    for _, b in df.iterrows():
        start = b["start"]
        end   = b["end"]
        illiq_block = feat.loc[start:end, "illiq_proxy_20"].median()
        rel_spreads.append(illiq_block)

    df["illiq_proxy_20_block"] = rel_spreads

    raw = pd.DataFrame(index=df.index)

    raw["Persistence"] = df["fut_efficiency"]
    raw["Reversal"]    = df["fut_signchg"]
    raw["Vol"]         = df["fut_vol"]
    raw["RV"]          = df["fut_rv"]
    raw["Spread"]      = df["illiq_proxy_20_block"]

    center = raw.median()
    scale  = raw.apply(lambda x: np.median(np.abs(x - x.median()))) + eps
    z      = (raw - center) / scale

    df["score_momentum"] = (
        + 1.00 * z["Persistence"]
        - 0.50 * z["Reversal"]
        - 0.25 * z["Vol"]
        - 0.25 * z["Spread"]
    )

    df["score_stress"] = (
        + 0.60 * z["Vol"]
        + 0.60 * z["RV"]
        + 0.50 * z["Spread"]
        - 0.20 * z["Persistence"]
    )

    df["score_mean_reverting"] = (
        + 1.00 * z["Reversal"]
        - 0.70 * z["Persistence"]
        - 0.20 * z["Vol"]
        - 0.20 * z["Spread"]
    )

    df["score_sideways_low_vol"] = (
        - 0.60 * z["Vol"]
        - 0.60 * z["RV"]
        - 0.40 * z["Persistence"]
        - 0.20 * z["Spread"]
    )

    df["score_volatile_choppy"] = (
        + 0.60 * z["Vol"]
        + 0.60 * z["Reversal"]
        - 0.50 * z["Persistence"]
    )

    score_cols = [
        "score_momentum",
        "score_stress",
        "score_mean_reverting",
        "score_sideways_low_vol",
        "score_volatile_choppy",
    ]

    label_map = {
        "score_momentum":        "momentum",
        "score_stress":          "stress",
        "score_mean_reverting":  "mean_reverting",
        "score_sideways_low_vol":"sideways_low_vol",
        "score_volatile_choppy": "volatile_choppy",
    }

    scores = df[score_cols]

    df["best_score_name"] = scores.idxmax(axis=1)
    df["best_score"]      = scores.max(axis=1)

    sorted_scores       = np.sort(scores.values, axis=1)
    df["score_margin"]  = sorted_scores[:, -1] - sorted_scores[:, -2]

    df["block_label"] = df["best_score_name"].map(label_map)

    df.loc[df["score_margin"] < min_margin, "block_label"] = "mixed_unclear"

    df["block_label_confidence"] = df["score_margin"]

    return df

def load_spot():
    df = pd.read_excel(SPOT_PATH, skiprows=1)
    df.columns = df.columns.str.strip()

    df["DATE"] = pd.to_datetime(df["DATE"], errors="coerce")
    df["BID"] = pd.to_numeric(df["BID"], errors="coerce")
    df["OFFER"] = pd.to_numeric(df["OFFER"], errors="coerce")

    df["BID"] = df["BID"].ffill(limit=3)
    df["OFFER"] = df["OFFER"].ffill(limit=3)

    df["MID"] = (df["BID"] + df["OFFER"]) / 2.0
    df["BA_SPREAD"] = df["OFFER"] - df["BID"]

    df = (
        df[["DATE", "FUTURES", "BID", "OFFER", "MID", "BA_SPREAD"]]
        .dropna(subset=["DATE", "FUTURES", "MID", "BID", "OFFER"])
        .sort_values("DATE")
        .rename(columns={"DATE": "Date"})
        .groupby("Date", as_index=False)
        .last()
    )

    return df


def load_futures():
    df = pd.read_excel(FUTURES_PATH)
    df.columns = df.columns.str.strip()

    df["Date"] = pd.to_datetime(df["Date"], errors="coerce")
    df["Close"] = pd.to_numeric(df["Close"], errors="coerce")
    df["Volume"] = pd.to_numeric(df["Volume"], errors="coerce")
    df = (
        df[["Date", "Close","Volume"]]
        .dropna()
        .sort_values("Date")
        .groupby("Date", as_index=False)
        .last()
        .rename(columns={"Close": "FUTURES_CLOSE"})
    )

    df = df[df["FUTURES_CLOSE"] > 0].copy()
    return df


def build_dataset(shift_spot=True):
    spot = load_spot()
    fut = load_futures()

    data = pd.merge(spot, fut, on="Date", how="inner")
    data = data.sort_values("Date")

    if shift_spot:
        for c in ["BID", "OFFER", "MID", "BA_SPREAD"]:
            data[c] = data[c].shift(1)

    data = data.dropna(subset=["MID", "FUTURES_CLOSE"])
    data = data[
        (data["MID"] > 0) &
        (data["FUTURES_CLOSE"] > 0) &
        (data["BA_SPREAD"] >= 0)
    ]

    return data.set_index("Date")


