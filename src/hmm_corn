def summarize_block_labels(block_labeled):
    counts = pd.crosstab(
        block_labeled["state"],
        block_labeled["block_label"]
    )

    probs = counts.div(counts.sum(axis=1), axis=0)

    summary = block_labeled.groupby("state")[[
    "length", "fut_return", "fut_abs_return", "fut_efficiency",
    "fut_rv", "fut_vol", "fut_signchg",
    "illiq_proxy_20_block",
]].median()

    return counts, probs, summary

def derive_state_labels_from_block_probs(probs, min_prob=0.35):
    labels = {}

    for state in probs.index:
        best_label = probs.loc[state].idxmax()
        best_prob = probs.loc[state].max()

        if best_prob >= min_prob:
            labels[int(state)] = best_label
        else:
            labels[int(state)] = "mixed_unclear"

    return labels
