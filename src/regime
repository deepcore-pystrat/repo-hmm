def load_spot_data():
    spot = pd.read_excel(SPOT_PATH, skiprows=1)
    spot.columns = spot.columns.str.strip()

    spot["DATE"] = pd.to_datetime(spot["DATE"], errors="coerce")
    spot["BID"] = pd.to_numeric(spot["BID"], errors="coerce")
    spot["OFFER"] = pd.to_numeric(spot["OFFER"], errors="coerce")

    spot["MID"] = (spot["BID"] + spot["OFFER"]) / 2
    spot["BA_SPREAD"] = spot["OFFER"] - spot["BID"]

    spot = spot.rename(columns={"DATE": "Date"})
    spot = spot[["Date", "BID", "OFFER", "MID", "BA_SPREAD"]]
    spot = spot.dropna()
    spot = spot.sort_values("Date").groupby("Date", as_index=False).last()

    return spot

def build_regime0_from_breaks(n, breaks, proba0):
    regime = np.zeros(n, dtype=int)

    current = 0  # 0 = hors régime, 1 = régime 0

    last = 0

    for b in breaks:
        regime[last:b] = current

        # flip régime
        current = 1 - current
        last = b

    regime[last:] = current

    # IMPORTANT : décider le premier état
    if np.mean(proba0[:10]) > 0.5:
        regime = 1 - regime

    return regime
def load_futures_data():
    fut = pd.read_csv(FUTURES_PATH, sep=";")
    fut.columns = fut.columns.str.strip()

    fut["Date"] = pd.to_datetime(fut["Date"], errors="coerce")
