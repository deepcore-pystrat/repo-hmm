def fit_hmm(X):
    if HMM_TYPE == "student":
        cfg = StudentTHMMConfig(
    K=NB_STATES,
    n_iter=N_ITER,
    seed=SEED,
    cov_type=COV_TYPE,
    sticky=50.0
)
    else:
        cfg = GaussianHMMConfig(K=NB_STATES, n_iter=N_ITER, seed=SEED)

    model = create_hmm(cfg)

    if hasattr(model, "fit_multi_start"):
        result = model.fit_multi_start(X, seeds=MULTI_START_SEEDS)
    else:
        result = model.fit(X)

    return model, result


def reorder_states(states, probas, returns):
    df = pd.DataFrame({"state": states, "ret": returns})
    means = df.groupby("state")["ret"].mean().sort_values()

    mapping = {old: new for new, old in enumerate(means.index)}

    states_new = np.array([mapping[s] for s in states])

    probas_new = np.zeros_like(probas)
    for old, new in mapping.items():
        probas_new[:, new] = probas[:, old]

    return states_new, probas_new, mapping


def apply_mapping(states, probas, mapping):
    states_new = np.array([mapping[s] for s in states])

    probas_new = np.zeros_like(probas)
    for old, new in mapping.items():
        probas_new[:, new] = probas[:, old]

    return states_new, probas_new


