def logit_transform(p, eps=1e-6):
    p = np.clip(p, eps, 1 - eps)
    return np.log(p / (1 - p))


def bocpd_gaussian_mean(x, hazard=1/80, mu0=0.0, sigma0=5.0, sigma=1.0):
    x = np.asarray(x, dtype=float)
    T = len(x)

    R = np.zeros((T + 1, T + 1))
    R[0, 0] = 1.0

    mu = np.full(T + 1, mu0)
    var = np.full(T + 1, sigma0**2)

    cp_prob = np.zeros(T)
    map_run = np.zeros(T, dtype=int)

    for t in range(1, T + 1):
        xt = x[t - 1]

        pred_mean = mu[:t]
        pred_var = sigma**2 + var[:t]

        pred_prob = norm.pdf(
            xt,
            loc=pred_mean,
            scale=np.sqrt(pred_var)
        )

        growth = R[t - 1, :t] * pred_prob * (1 - hazard)
        cp = np.sum(R[t - 1, :t] * pred_prob * hazard)

        R[t, 1:t + 1] = growth
        R[t, 0] = cp

        R[t, :t + 1] /= np.sum(R[t, :t + 1]) + 1e-12

        cp_prob[t - 1] = R[t, 0]
        map_run[t - 1] = np.argmax(R[t, :t + 1])

        old_mu = mu.copy()
        old_var = var.copy()

        var[1:t + 1] = 1 / (1 / old_var[:t] + 1 / sigma**2)
        mu[1:t + 1] = var[1:t + 1] * (
            old_mu[:t] / old_var[:t] + xt / sigma**2
        )

        mu[0] = mu0
        var[0] = sigma0**2

    return R, cp_prob, map_run
def diagnose_proba_distribution(proba0):
    import matplotlib.pyplot as plt

    # logit transform
    eps = 1e-6
    p = np.clip(proba0, eps, 1 - eps)
    logit_p = np.log(p / (1 - p))

    fig, axes = plt.subplots(2, 2, figsize=(12, 8))

    # ---- Raw proba histogram ----
    axes[0, 0].hist(proba0, bins=50)
    axes[0, 0].set_title("Histogram P(state 0)")

    # ---- Raw time series ----
    axes[0, 1].plot(proba0)
    axes[0, 1].set_title("Time series P(state 0)")

    # ---- Logit histogram ----
    axes[1, 0].hist(logit_p, bins=50)
    axes[1, 0].set_title("Histogram logit(P)")

    # ---- Logit time series ----
    axes[1, 1].plot(logit_p)
    axes[1, 1].set_title("Time series logit(P)")

    plt.tight_layout()
    plt.show()

    return logit_p
def plot_bocpd_breakpoints(index, proba0, cp_prob, map_run_length, cp_threshold=0.3):
    breaks = np.where(cp_prob > cp_threshold)[0]

    plt.figure(figsize=(16, 5))
    plt.plot(index, proba0, label="P(state 0)", color="black")

    for b in breaks:
        plt.axvline(index[b], color="red", alpha=0.6)

    plt.title("BOCPD sur P(state 0) - points de rupture")
    plt.legend()
    plt.grid()
    plt.show()

    plt.figure(figsize=(16, 4))
    plt.plot(index, cp_prob, label="P(r_t = 0 | x_1:t)")
    plt.axhline(cp_threshold, linestyle="--", label="seuil rupture")

    for b in breaks:
        plt.axvline(index[b], color="red", alpha=0.4)

    plt.title("Probabilité de change-point selon BOCPD")
    plt.legend()
    plt.grid()
    plt.show()

    plt.figure(figsize=(16, 4))
    plt.plot(index, map_run_length)
    plt.title("Run length MAP")
    plt.grid()
    plt.show()

    return breaks
