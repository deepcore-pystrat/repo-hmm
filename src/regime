    X_test = feat_test.values

    X_train, X_test, _, _ = standardize(X_train, X_test)

    model, result = fit_hmm(X_train)

    train_states, train_proba, _ = model.filter(X_train)

    train_states, train_proba, mapping = reorder_states(
        train_states,
        train_proba,
        feat_train["r_mid"].values
    )

    test_states, test_proba, _ = model.filter(X_test)

    test_states, test_proba = apply_mapping(
        test_states,
        test_proba,
        mapping
    )

    df = test.copy()
