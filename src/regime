def build_hmm_features(df, window=20):
    out = pd.DataFrame(index=df.index)

    mid = df["MID"]
    bid = df["BID"]
    offer = df["OFFER"]

    log_mid = np.log(mid)
    r = log_mid.diff()

    rel_spread = (offer - bid) / mid

    # =========================
    # 1. PRICE / MOMENTUM
    # =========================
    out["r_mid"] = r

    out["mom_10"] = log_mid.diff(10)
    out["mom_20"] = log_mid.diff(20)

    

    out["trend_slope_20"] = rolling_slope(log_mid, window=20)


    # =========================
    # 2. VOLATILITY / CRISIS
    # =========================
    out["vol_10"] = r.rolling(10).std()
    out["vol_20"] = r.rolling(20).std()

    out["vol_ratio_10_60"] = (
        r.rolling(10).std()
        / r.rolling(60).std()
    )

    

    # =========================
    # 3. BID-ASK / LIQUIDITY
    # =========================
    out["rel_spread"] = rel_spread

    

    

    out["illiq"] = rel_spread * np.abs(r)

    

    out = out.replace([np.inf, -np.inf], np.nan)
    out = out.dropna()

    return out

